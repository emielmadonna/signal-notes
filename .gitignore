# Secrets — never committed (constitution: hard boundaries)
.env
.env.*
!.env.example

# Local-only notes for Emiel (private, not repo material)
*.local.md

# Dependencies / build output (populated in P1)
node_modules/
.next/
out/
*.tsbuildinfo

# OS noise
.DS_Store

# --- Merged from the Next.js scaffold's .gitignore (P1 card-1) ---
# (its `.env*` line is intentionally NOT merged: it would re-ignore
# .env.example, which we track on purpose; secrets are covered above)

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
e2e/.results/
e2e/fixtures/
