# Secrets — never committed (constitution: hard boundaries)
.env
.env.*
!.env.example

# Local-only notes for Emiel (private, not repo material)
*.local.md

# Dependencies / build output (populated in P1)
node_modules/
.next/
out/
*.tsbuildinfo

# OS noise
.DS_Store

# --- Merged from the Next.js scaffold's .gitignore (P1 card-1) ---
# (its `.env*` line is intentionally NOT merged: it would re-ignore
# .env.example, which we track on purpose; secrets are covered above)

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
e2e/.results/

# Per-run SCREENSHOTS. e2e/helpers.ts writes here unless EVIDENCE_PROMOTE=1,
# so verifying the app no longer rewrites the committed evidence in place.
# The evidence a Change Card cites is promoted and `git add`ed deliberately.
shiplog/runs/

# Per-run verifier reports are transient; keyed evidence is committed explicitly.
shiplog/evidence/constitution-*.txt
shiplog/evidence/r1-naked-tables-*.txt
shiplog/evidence/r1-probe-2*.txt
# The upload suite WRITES this one at run time (the 415 case) and deletes it
# again; the four real fixtures next to it are committed on purpose, because
# without them CI cannot exercise PDF/DOCX/RTF ingestion at all.
e2e/fixtures/e2e-reject.jpeg
