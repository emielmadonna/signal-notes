# Signal Notes — environment variables (names only; values live in .env.local
# and in Vercel's server-side env settings, entered by Emiel, never committed).

# --- Client-safe (browser may see these) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only. NEVER prefix these with NEXT_PUBLIC_. ---
# Supabase service-role key: seed script + probe only, never app runtime client code.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection: constitution.sh live checks (R1a/R4) + CI.
DATABASE_URL=
# Anthropic API key (console.anthropic.com): used ONLY inside the server-side
# briefing generation route (P4). Model: claude-sonnet-5.
ANTHROPIC_API_KEY=
# Password for the two seeded test users (scripts/seed.ts sets it, scripts/two-org-probe.ts signs in with it).
SEED_USER_PASSWORD=
